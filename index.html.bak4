<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Catering Food Labels — One-off Print</title>
    <style>
      * {
        box-sizing: border-box;
      }
      html {
        color-scheme: dark;
      }
      body {
        margin: 0;
        min-height: 100vh;
        background: #101010;
        color: #eee;
        font-family:
          system-ui,
          -apple-system,
          BlinkMacSystemFont,
          "Segoe UI",
          sans-serif;
      }
      button,
      select,
      textarea,
      input {
        font: inherit;
      }
      button {
        cursor: pointer;
        min-height: 40px;
        padding: 9px 14px;
        border: 1px solid #3b3b3b;
        border-radius: 7px;
        background: #202020;
        color: #ddd;
      }
      button:hover:not(:disabled) {
        background: #292929;
        border-color: #4a4a4a;
      }
      button:disabled {
        opacity: 0.5;
        cursor: default;
      }
      .app {
        width: min(760px, 100%);
        margin: 0 auto;
        padding: 32px 24px 48px;
      }
      h1 {
        margin: 0 0 10px;
        font-size: 24px;
        line-height: 1.2;
        font-weight: 650;
        letter-spacing: -0.02em;
      }
      .intro {
        margin: 0 0 22px;
        color: #888;
        font-size: 14px;
        line-height: 1.5;
      }
      label {
        display: block;
        margin-bottom: 8px;
        color: #bbb;
        font-size: 14px;
        font-weight: 550;
      }
      textarea {
        display: block;
        width: 100%;
        min-height: 300px;
        resize: vertical;
        padding: 13px 14px;
        border: 1px solid #383838;
        border-radius: 8px;
        background: #1b1b1b;
        color: #eee;
        font-size: 15px;
        line-height: 1.6;
        outline: none;
      }
      textarea:focus {
        border-color: #666;
        background: #202020;
      }
      textarea::placeholder {
        color: #777;
      }
      .hint {
        margin: 8px 0 20px;
        color: #777;
        font-size: 13px;
      }
      .image-tools {
        margin: 0 0 18px;
        padding: 14px;
        border: 1px solid #303030;
        border-radius: 8px;
        background: #181818;
      }
      .image-tools label {
        margin-bottom: 9px;
      }
      .image-controls {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 9px;
      }
      .image-controls input[type="file"] {
        flex: 1;
        min-width: 180px;
        max-width: 100%;
        color: #aaa;
        font-size: 13px;
      }
      .image-note {
        margin: 9px 0 0;
        color: #777;
        font-size: 12px;
        line-height: 1.5;
      }
      .progress-track {
        height: 3px;
        margin-top: 10px;
        overflow: hidden;
        border-radius: 3px;
        background: #303030;
      }
      .progress-bar {
        width: 0;
        height: 100%;
        background: #ddd;
        transition: width 0.15s ease;
      }
      .actions {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 14px;
        margin-top: 18px;
      }
      .language {
        display: flex;
        align-items: center;
        gap: 9px;
      }
      .language label {
        margin: 0;
        color: #888;
        font-size: 13px;
      }
      select {
        min-height: 40px;
        padding: 8px 30px 8px 10px;
        border: 1px solid #3b3b3b;
        border-radius: 7px;
        background: #202020;
        color: #ddd;
      }
      .buttons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
      }
      .primary {
        border-color: #e0e0e0;
        background: #eee;
        color: #111;
      }
      .primary:hover:not(:disabled) {
        background: #fff;
        border-color: #fff;
      }
      .status {
        min-height: 20px;
        margin-top: 16px;
        color: #888;
        font-size: 13px;
      }
      .status.error {
        color: #e07070;
      }
      @media (max-width: 520px) {
        .app {
          padding: 22px 14px 36px;
        }
        h1 {
          font-size: 22px;
        }
        textarea {
          min-height: 240px;
        }
        .actions,
        .language,
        .buttons {
          width: 100%;
        }
        .actions {
          align-items: stretch;
        }
        .language {
          justify-content: flex-start;
        }
        .buttons button {
          flex: 1;
        }
        .image-controls {
          align-items: stretch;
          flex-direction: column;
        }
        .image-controls button {
          width: 100%;
        }
      }
    </style>
  </head>
  <body>
    <main class="app">
      <h1>Catering Food Labels</h1>
      <p class="intro">
        Paste the food names you want to print, one name per line. This list is
        temporary and is never saved to the database.
      </p>

      <label for="foodNames">Food names</label>
      <textarea
        id="foodNames"
        placeholder="Chicken curry
Roasted vegetables
Potato salad"
        spellcheck="false"
      ></textarea>
      <p class="hint" id="lineCount">0 food names · Blank lines are ignored</p>

      <section class="image-tools" aria-labelledby="imageHeading">
        <label id="imageHeading" for="imageFile"
          >Extract names from an image</label
        >
        <div class="image-controls">
          <input id="imageFile" type="file" accept="image/*" />
          <button id="extractTextBtn" type="button">Extract text</button>
        </div>
        <p class="image-note">
          For best results, use a clear screenshot or crop around the food-name
          column. Estonian OCR runs in your browser; check the result below and
          correct any mistakes before printing. The image and extracted text are
          not saved to a database.
        </p>
        <div class="progress-track" id="ocrProgressTrack" hidden>
          <div class="progress-bar" id="ocrProgressBar"></div>
        </div>
      </section>

      <div class="actions">
        <div class="language">
          <label for="printLanguage">Print:</label>
          <select id="printLanguage">
            <option value="et">Estonian</option>
            <option value="en">English</option>
            <option value="both">Both</option>
          </select>
        </div>
        <div class="buttons">
          <button class="primary" id="generatePdfBtn" type="button">
            Generate PDF
          </button>
          <button id="sendToPrinterBtn" type="button">Send to Printer</button>
        </div>
      </div>
      <div class="status" id="status" role="status" aria-live="polite"></div>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/tesseract.js@5/dist/tesseract.min.js"></script>
    <script>
      // The names are only held in this page and are never written to Supabase.
      const SUPABASE_URL = "https://kwmtcmsbpqkssljkhyys.supabase.co";
      const SUPABASE_KEY = "sb_publishable_-KFIl3iWYa-T_7q8AMnVvw_x7DAaZv3";

      const foodNames = document.querySelector("#foodNames");
      const lineCount = document.querySelector("#lineCount");
      const printLanguage = document.querySelector("#printLanguage");
      const generatePdfBtn = document.querySelector("#generatePdfBtn");
      const sendToPrinterBtn = document.querySelector("#sendToPrinterBtn");
      const status = document.querySelector("#status");
      const imageFile = document.querySelector("#imageFile");
      const extractTextBtn = document.querySelector("#extractTextBtn");
      const ocrProgressTrack = document.querySelector("#ocrProgressTrack");
      const ocrProgressBar = document.querySelector("#ocrProgressBar");

      function getFoodsForPrint() {
        return foodNames.value
          .split(/\r?\n/)
          .map((name) => name.trim())
          .filter(Boolean)
          .map((name) => ({ name_et: name, name_en: "" }));
      }

      function updateLineCount() {
        const count = getFoodsForPrint().length;
        lineCount.textContent = `${count} food name${count === 1 ? "" : "s"} · Blank lines are ignored`;
      }

      function setStatus(message, isError = false) {
        status.textContent = message;
        status.className = isError ? "status error" : "status";
      }

      async function submitLabels(action) {
        const foods = getFoodsForPrint();
        if (!foods.length) {
          alert("Paste at least one food name, with one name per line.");
          foodNames.focus();
          return;
        }

        const button =
          action === "download" ? generatePdfBtn : sendToPrinterBtn;
        const originalText =
          action === "download" ? "Generate PDF" : "Send to Printer";
        button.disabled = true;
        button.textContent =
          action === "download" ? "Generating PDF…" : "Sending…";
        setStatus(
          action === "download"
            ? "Generating PDF…"
            : "Sending labels to printer…",
        );

        try {
          const response = await fetch(
            `${SUPABASE_URL}/functions/v1/generate-label-pdf`,
            {
              method: "POST",
              headers: {
                "Content-Type": "application/json",
                apikey: SUPABASE_KEY,
                Authorization: `Bearer ${SUPABASE_KEY}`,
              },
              body: JSON.stringify({
                foods,
                language: printLanguage.value,
                action,
              }),
            },
          );

          if (!response.ok) {
            let message =
              action === "download"
                ? "Failed to generate PDF."
                : "Failed to send labels.";
            try {
              const error = await response.json();
              if (error.error) message = error.error;
            } catch {
              /* Response wasn't JSON. */
            }
            throw new Error(message);
          }

          if (action === "download") {
            const blob = await response.blob();
            const url = URL.createObjectURL(blob);
            const link = document.createElement("a");
            link.href = url;
            link.download = "food-labels.pdf";
            document.body.appendChild(link);
            link.click();
            link.remove();
            URL.revokeObjectURL(url);
            setStatus(
              `PDF generated with ${foods.length} food label${foods.length === 1 ? "" : "s"}.`,
            );
          } else {
            await response.json();
            setStatus(
              `Sent ${foods.length} food label${foods.length === 1 ? "" : "s"} successfully.`,
            );
            alert("Labels sent successfully.");
          }
        } catch (error) {
          console.error(error);
          const message =
            error instanceof Error ? error.message : "Something went wrong.";
          setStatus(message, true);
          alert(message);
        } finally {
          button.disabled = false;
          button.textContent = originalText;
        }
      }

      /**
       * Prepare an image for OCR.
       * Upscales small text, converts it to grayscale, and
       * improves contrast while preserving Estonian characters.
       */
      async function prepareImageForOCR(file) {
        const bitmap = await createImageBitmap(file);

        try {
          const maxDimension = 2400;
          const scale = Math.min(
            3,
            maxDimension / Math.max(bitmap.width, bitmap.height),
          );

          const canvas = document.createElement("canvas");
          canvas.width = Math.max(1, Math.round(bitmap.width * scale));
          canvas.height = Math.max(1, Math.round(bitmap.height * scale));

          const ctx = canvas.getContext("2d", {
            willReadFrequently: true,
          });

          ctx.fillStyle = "#ffffff";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.drawImage(bitmap, 0, 0, canvas.width, canvas.height);

          const image = ctx.getImageData(0, 0, canvas.width, canvas.height);
          const pixels = image.data;

          // Grayscale and contrast enhancement.
          // Keep grayscale rather than applying aggressive thresholding:
          // thin letters and Estonian diacritics can otherwise disappear.
          for (let i = 0; i < pixels.length; i += 4) {
            const gray =
              0.299 * pixels[i] + 0.587 * pixels[i + 1] + 0.114 * pixels[i + 2];

            const contrast = Math.max(
              0,
              Math.min(255, (gray - 128) * 1.35 + 128),
            );

            pixels[i] = contrast;
            pixels[i + 1] = contrast;
            pixels[i + 2] = contrast;
          }

          ctx.putImageData(image, 0, 0);

          return canvas;
        } finally {
          bitmap.close();
        }
      }

      function cleanOCRLines(text) {
        return text
          .normalize("NFC")
          .replace(/\r/g, "\n")
          .split("\n")
          .map((line) =>
            line
              .replace(/[\t ]+/g, " ")
              .replace(/^[|¦•·\s]+|[|¦•·\s]+$/g, "")
              .trim(),
          )
          .filter((line) => {
            if (!line) return false;

            // Discard obvious separator lines, not legitimate short names.
            if (/^[-_=~.]+$/.test(line)) return false;

            return true;
          });
      }

      async function extractNamesFromImage() {
        const file = imageFile.files?.[0];

        if (!file || !file.type.startsWith("image/")) {
          setStatus("Choose a valid image first.", true);
          return;
        }

        if (typeof Tesseract === "undefined") {
          setStatus("OCR library failed to load. Reload the page.", true);
          return;
        }

        if (
          foodNames.value.trim() &&
          !confirm("Replace the existing food names with the extracted text?")
        ) {
          return;
        }

        extractTextBtn.disabled = true;
        generatePdfBtn.disabled = true;
        sendToPrinterBtn.disabled = true;
        extractTextBtn.textContent = "Reading image…";
        ocrProgressTrack.hidden = false;
        ocrProgressBar.style.width = "0%";
        setStatus("Preparing image for Estonian text recognition…");

        let worker;

        try {
          const image = await prepareImageForOCR(file);

          worker = await Tesseract.createWorker("est", 1, {
            logger(message) {
              if (message.status) {
                const percent = Math.round((message.progress || 0) * 100);
                ocrProgressBar.style.width = `${percent}%`;

                const descriptions = {
                  "loading tesseract core": "Loading OCR engine…",
                  "loading language traineddata":
                    "Loading Estonian language data…",
                  "recognizing text": `Recognizing text… ${percent}%`,
                };

                setStatus(
                  descriptions[message.status] || "Preparing text recognition…",
                );
              }
            },
          });

          await worker.setParameters({
            tessedit_pageseg_mode: "6",
            preserve_interword_spaces: "1",
            user_defined_dpi: "300",
          });

          const result = await worker.recognize(image);
          const lines = cleanOCRLines(result.data.text || "");

          foodNames.value = lines.join("\n");
          updateLineCount();

          ocrProgressBar.style.width = "100%";

          if (lines.length) {
            setStatus(
              `Extracted ${lines.length} lines. ` +
                `OCR confidence: ${Math.round(result.data.confidence)}%. ` +
                "Review the text and correct any mistakes before printing.",
            );
            foodNames.focus();
          } else {
            setStatus(
              "No text detected. Try a clearer image or crop it around the text.",
              true,
            );
          }
        } catch (error) {
          console.error("OCR error:", error);
          setStatus(
            "Text extraction failed. Check your connection and try again.",
            true,
          );
        } finally {
          if (worker) {
            await worker.terminate().catch(() => {});
          }

          extractTextBtn.disabled = false;
          generatePdfBtn.disabled = false;
          sendToPrinterBtn.disabled = false;
          extractTextBtn.textContent = "Extract text";

          window.setTimeout(() => {
            ocrProgressTrack.hidden = true;
          }, 900);
        }
      }

      foodNames.addEventListener("input", updateLineCount);
      extractTextBtn.addEventListener("click", extractNamesFromImage);
      generatePdfBtn.addEventListener("click", () => submitLabels("download"));
      sendToPrinterBtn.addEventListener("click", () => submitLabels("email"));
      updateLineCount();
    </script>
  </body>
</html>
